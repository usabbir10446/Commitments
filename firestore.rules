rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    /**
     * UNIVERSAL ACCESS (DEVELOPMENT ONLY)
     * Paste this snippet into the "Rules" tab of your Firebase Cloud Firestore console.
     * This allows the app to communicate with your project immediately.
     */
    match /{document=**} {
      allow read, write: if true;
    }
  }
}